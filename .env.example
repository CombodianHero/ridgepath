# --- Database (Neon Postgres) ---
# Get this from neon.tech after creating a free project.
# Use the "pooled connection" string for serverless/Vercel.
DATABASE_URL="postgresql://user:password@ep-xxxx.neon.tech/neondb?sslmode=require"

# --- NextAuth ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-byte-string"
NEXTAUTH_URL="http://localhost:3000"

# --- Gmail SMTP (for OTP emails) ---
# 1. Enable 2-Step Verification on the Gmail account: https://myaccount.google.com/security
# 2. Create an App Password: https://myaccount.google.com/apppasswords
# 3. Use that 16-character app password below (NOT your normal Gmail password)
SMTP_EMAIL="youraccount@gmail.com"
SMTP_APP_PASSWORD="xxxx xxxx xxxx xxxx"

# --- Optional: seed the first admin account ---
ADMIN_NAME="Site Admin"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="ChangeMe123!"
